# ======================================================
# APLIKASI WEB - POSTGRESQL NATIVE (TANPA DOCKER)
# ======================================================
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta
JWT_SECRET=ganti-dengan-rahasia-minimal-32-karakter
COOKIE_SECURE=false
ADMIN_EMAIL=admin@lps.local
ADMIN_PASSWORD=Admin123!

# PostgreSQL yang dipasang langsung di Windows atau Linux.
# Password di bawah hanya untuk pengujian lokal; ganti sebelum produksi.
DATABASE_URL=postgresql://timbangqr:timbangqr_local_2026@localhost:5432/timbangqr
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Untuk production Vercel, biarkan false: jalankan npm run db:init sekali saja.
# Untuk local development, default aplikasi tetap melakukan inisialisasi otomatis.
DATABASE_AUTO_INIT=true

# Digunakan oleh script penyiapan PostgreSQL Windows.
POSTGRES_ADMIN_USER=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Device/API key harus sama pada server dan komputer operator.
SERIAL_DEVICE_ID=TIMBANG-HJ-SERIAL-01
SERIAL_API_KEY=serial-api-key-ganti-dengan-random-panjang

# local = web app dan Serial Agent berada di komputer yang sama.
# remote = web app di Hostinger; Serial Agent berada di komputer operator.
SERIAL_BRIDGE_MODE=local
SERIAL_BRIDGE_ADMIN_KEY=bridge-admin-key-ganti-dengan-random-panjang
SERIAL_BRIDGE_HOST=127.0.0.1
SERIAL_BRIDGE_PORT=8787

# ======================================================
# SERIAL AGENT DI KOMPUTER OPERATOR
# ======================================================
SERIAL_INGEST_URL=http://127.0.0.1:3000/api/serial/ingest
SERIAL_PORT=
SERIAL_INTERFACE=RS232
SERIAL_BAUD_RATE=9600
SERIAL_DATA_BITS=8
SERIAL_STOP_BITS=1
SERIAL_PARITY=none
SERIAL_FRAME_MODE=line
SERIAL_DELIMITER=\r\n
SERIAL_IDLE_TIMEOUT_MS=120
SERIAL_WEIGHT_REGEX=[-+]?\d+(?:[.,]\d+)?
SERIAL_WEIGHT_MULTIPLIER=1
SERIAL_STABLE_REGEX=\b(ST|STAB|STABLE)\b
SERIAL_UNSTABLE_REGEX=\b(US|UNST|UNSTABLE)\b
SERIAL_STABLE_SAMPLES=3
SERIAL_STABLE_TOLERANCE_KG=1
SERIAL_AUTO_CONNECT=false

# ======================================================
# SINKRONISASI TRANSAKSI FINAL KE DASHBOARD LPS
# ======================================================
# Diisi hanya pada komputer/server TimbangQR. Jangan diekspos ke browser.
LPS_INTEGRATION_URL=https://lps-app-iota.vercel.app/api/integrations/timbangqr/weighings
LPS_INTEGRATION_SECRET=ganti-dengan-rahasia-yang-sama-dengan-LPS
LPS_TRANSDEPO=HARAPAN_JAYA

# ======================================================
# VALIDASI QR ARMADA LPS -> TIMBANGQR-OCR-LED
# ======================================================
# URL endpoint JSON GET master armada dari LPS Pekanbaru.
LPS_ARMADA_API_URL=https://lps-app-iota.vercel.app/api/integrations/timbangqr/armada
# Secret gunakan LPS_INTEGRATION_SECRET di atas (hanya pada server).
# QR LPS divalidasi saat scan. Jika master armada belum ada di TimbangQR,
# akan ditambahkan sebagai armada baru (tare harus dikonfirmasi operator).
