# Untuk pengujian lokal. Ganti menjadi URL HTTPS Hostinger saat produksi.
SERIAL_INGEST_URL=http://127.0.0.1:3000/api/serial/ingest
SERIAL_DEVICE_ID=TIMBANG-HJ-SERIAL-01
SERIAL_API_KEY=serial-api-key-ganti-dengan-random-panjang

# API konfigurasi lokal, hanya bisa diakses dari komputer operator
SERIAL_BRIDGE_ADMIN_KEY=bridge-admin-key-ganti-dengan-random-panjang
SERIAL_BRIDGE_HOST=127.0.0.1
SERIAL_BRIDGE_PORT=8787

SERIAL_PORT=COM3
SERIAL_INTERFACE=RS232
SERIAL_BAUD_RATE=9600
SERIAL_DATA_BITS=8
SERIAL_STOP_BITS=1
SERIAL_PARITY=none
SERIAL_FRAME_MODE=line
SERIAL_DELIMITER=\r\n
SERIAL_IDLE_TIMEOUT_MS=120
SERIAL_WEIGHT_REGEX=[-+]?\d+(?:[.,]\d+)?
SERIAL_WEIGHT_MULTIPLIER=1
SERIAL_STABLE_REGEX=\b(ST|STAB|STABLE)\b
SERIAL_UNSTABLE_REGEX=\b(US|UNST|UNSTABLE)\b
SERIAL_STABLE_SAMPLES=3
SERIAL_STABLE_TOLERANCE_KG=1
SERIAL_AUTO_CONNECT=true
